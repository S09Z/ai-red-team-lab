# Copy to `.env` and set values. Never commit real secrets.

# Session signing secret. Empty -> an ephemeral random value is generated at
# startup (fine for dev/CI; set a stable value for real deployments).
PORTAL_SECRET_KEY=

# Stub/dev login for CI + offline development (no real OAuth needed).
AUTH_STUB=1

DATABASE_URL=sqlite+aiosqlite:///./portal.db

# SPA origin; CORS is locked to exactly this.
FRONTEND_ORIGIN=http://localhost:5173

# Base URL the providers redirect back to (this API).
OAUTH_REDIRECT_BASE=http://localhost:8000

# Optional real OAuth apps. Leave blank to keep the provider disabled (its
# routes return 503). Register at github.com/settings/developers and
# console.cloud.google.com; redirect URI: <OAUTH_REDIRECT_BASE>/auth/<p>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set COOKIE_SECURE=false only for plain-HTTP local testing.
# COOKIE_SECURE=true
