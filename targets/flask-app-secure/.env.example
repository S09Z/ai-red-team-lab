# Hardened target runtime secrets — copy to `.env` and set real values.
# These are read from the environment by create_app(); never commit real
# secrets. If unset, the app generates ephemeral random values at startup.
SECRET_KEY=
JWT_SECRET=

# Optional overrides (safe defaults live in config.py).
# SECURE_DATABASE=lab_secure.db
# CORS_ALLOWED_ORIGINS=
# JWT_EXPIRY_SECONDS=900
